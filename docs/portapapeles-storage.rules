// Regla de Mi Portapapeles para Storage. NO reemplaza tus reglas: copia solo el
// bloque "match /portapapeles/..." dentro de "match /b/{bucket}/o { ... }".
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---- Mi Portapapeles: archivos de hasta 25 MB, solo del dueño ----
    match /portapapeles/{uid}/{id}/{nombre} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size <= 25 * 1024 * 1024;
    }
    // ---- fin Mi Portapapeles ----

  }
}
