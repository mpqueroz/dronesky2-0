rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quién administra el sitio. Solo estas cuentas pueden editar.
    // (Antes bastaba con "tener sesión", y cualquiera puede crearse una
    // cuenta usando la clave pública que viene en la página.)
    function esAdmin() {
      return request.auth != null
          && request.auth.token.email in ['mpqueroz@gmail.com'];
    }
    function textoOk(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    // Propiedades y blog: todos leen, solo administración edita.
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /posts/{postId} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // Ajustes del sitio (foto y texto de la portada).
    match /settings/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // Formulario de contacto: cualquiera puede ENVIAR un mensaje con el
    // formato del sitio; solo administración lo lee o lo borra.
    match /messages/{msgId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'comuna', 'message', 'createdAt'])
                    && request.resource.data.keys().hasAll(['name', 'contact', 'message', 'createdAt'])
                    && textoOk(request.resource.data.name, 1, 100)
                    && textoOk(request.resource.data.contact, 1, 100)
                    && textoOk(request.resource.data.get('comuna', ''), 0, 80)
                    && textoOk(request.resource.data.message, 1, 2000)
                    && request.resource.data.createdAt == request.time;
      allow read, delete: if esAdmin();
      allow update: if false;
    }
    // Preguntas frecuentes: cualquiera puede preguntar (queda sin publicar);
    // el público solo ve las publicadas; administración responde y publica.
    match /questions/{qId} {
      allow create: if request.resource.data.keys().hasOnly(['question', 'answer', 'published', 'createdAt'])
                    && textoOk(request.resource.data.question, 1, 300)
                    && request.resource.data.answer == null
                    && request.resource.data.published == false
                    && request.resource.data.createdAt == request.time;
      allow read: if resource.data.published == true || esAdmin();
      allow update, delete: if esAdmin();
    }
    // Forjar (forjar-personal.web.app): cada persona solo ve y edita
    // sus propios datos. Nadie más puede leerlos, ni administración.
    match /forjar/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /dias/{dia} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }
    }
    // CopyGo (copygo.web.app): cada cuenta solo ve y edita lo suyo.
    match /copygo/{uid} {
      function esDueno() { return request.auth != null && request.auth.uid == uid; }
      function envioOk(d) {
        return d.keys().hasAll(['type', 'createdAt', 'from', 'dev'])
          && d.createdAt is int && d.from is string && d.from.size() <= 40
          && d.dev is string && d.dev.size() <= 40
          && ((d.type == 'text'
               && d.keys().hasOnly(['type', 'text', 'createdAt', 'from', 'dev', 'pinned'])
               && d.text is string && d.text.size() <= 200000)
           || (d.type == 'file'
               && d.keys().hasOnly(['type', 'name', 'size', 'mime', 'path', 'url', 'createdAt', 'from', 'dev', 'pinned'])
               && d.name is string && d.name.size() <= 300
               && d.size is int && d.size <= 26214400
               && d.mime is string && d.mime.size() <= 200
               && d.path is string && d.path.matches('copygo/' + uid + '/.+')
               && d.url is string && d.url.size() <= 2000));
      }
      // ajustes: cuánto tiempo se guardan los envíos
      allow read: if esDueno();
      allow write: if esDueno()
        && request.resource.data.keys().hasOnly(['ttlHours'])
        && request.resource.data.ttlHours is int
        && request.resource.data.ttlHours >= 0 && request.resource.data.ttlHours <= 8760;
      match /items/{id} {
        allow read, delete: if esDueno();
        allow create: if esDueno() && envioOk(request.resource.data);
        // lo único que se puede cambiar después es "fijado"
        allow update: if esDueno()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.pinned is bool;
      }
    }
    // Veterinaria: blog público y administración por UID.
    function isVetAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/vetAdministradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/vetAdministradores/$(request.auth.uid)).data.active == true;
    }
    function vetText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function validVetPost() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind','title','body','video','image','published','createdAt','publishedAt'])
        && d.keys().hasOnly(['kind','title','body','video','image','published','createdAt','publishedAt'])
        && d.kind in ['news','videos'] && vetText(d.title,1,140) && vetText(d.body,1,20000)
        && vetText(d.video,0,2000) && vetText(d.image,0,2000)
        && d.published is bool && d.createdAt is timestamp && d.publishedAt is timestamp;
    }
    match /vetAdministradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /vetPublicaciones/{id} {
      allow read: if resource.data.published == true || isVetAdmin();
      allow create: if isVetAdmin() && validVetPost() && request.resource.data.createdAt == request.time;
      allow update: if isVetAdmin() && validVetPost() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isVetAdmin();
    }
    match /vetPreguntasPrivadas/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','question','createdAt','status'])
        && request.resource.data.keys().hasOnly(['name','question','createdAt','status'])
        && vetText(request.resource.data.name,1,60)
        && vetText(request.resource.data.question,10,1000)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isVetAdmin();
      allow update: if isVetAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending','answered'];
    }
    match /vetRespuestas/{id} {
      allow read: if resource.data.published == true || isVetAdmin();
      allow create, update: if isVetAdmin()
        && request.resource.data.keys().hasAll(['question','answer','published','publishedAt'])
        && request.resource.data.keys().hasOnly(['question','answer','published','publishedAt'])
        && vetText(request.resource.data.question,10,1000)
        && vetText(request.resource.data.answer,1,10000)
        && request.resource.data.published == true
        && request.resource.data.publishedAt == request.time;
      allow delete: if isVetAdmin();
    }

    // ADICIONAR dentro de match /databases/{database}/documents, antes do bloqueio final.
    // Usa isVetAdmin() e vetText() já existentes. Não substitui regras de outros sites.
    function vetClinicalMeta(d) {
      return d.createdAt is timestamp && d.createdBy is string
        && d.updatedAt == request.time && d.updatedBy == request.auth.uid
        && d.updatedEmail == request.auth.token.email
        && d.revision is int && d.revision >= 1
        && vetText(d.lastChangeId, 1, 128);
    }
    function vetClinicalDate(value) {
      return value == '' || (value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }
    function vetPatientValid(d) {
      let keys = ['name','species','breed','birthDate','sex','weight','tutor','phone','address','background',
                  'createdAt','createdBy','updatedAt','updatedBy','updatedEmail','revision','lastChangeId'];
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys) && vetClinicalMeta(d)
        && vetText(d.name,1,100) && vetText(d.species,1,30) && vetText(d.breed,0,100)
        && vetClinicalDate(d.birthDate) && vetText(d.sex,0,30) && vetText(d.weight,0,20)
        && vetText(d.tutor,1,120) && vetText(d.phone,0,40) && vetText(d.address,0,250)
        && vetText(d.background,0,5000);
    }
    function vetVisitValid(d) {
      let keys = ['date','reason','weight','assessment','diagnosis','treatment','prevention','nextDate',
                  'createdAt','createdBy','updatedAt','updatedBy','updatedEmail','revision','lastChangeId'];
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys) && vetClinicalMeta(d)
        && d.date != '' && vetClinicalDate(d.date) && vetClinicalDate(d.nextDate)
        && vetText(d.reason,1,500) && vetText(d.weight,0,20) && vetText(d.assessment,0,5000)
        && vetText(d.diagnosis,0,3000) && vetText(d.treatment,0,5000) && vetText(d.prevention,0,3000);
    }
    function vetClinicalNew(d) {
      return d.createdAt == request.time && d.createdBy == request.auth.uid && d.revision == 1;
    }
    function vetClinicalUpdate(d, previous) {
      return d.createdAt == previous.createdAt && d.createdBy == previous.createdBy
        && d.revision == previous.revision + 1 && d.lastChangeId != previous.lastChangeId;
    }
    function vetClinicalLogged(patientId, type, id, previous) {
      let d = request.resource.data;
      let c = getAfter(/databases/$(database)/documents/vetPacientes/$(patientId)/cambios/$(d.lastChangeId)).data;
      return c.recordType == type && c.recordId == id && c.before == previous && c.after == d
        && c.createdAt == request.time && c.actorUid == request.auth.uid
        && c.actorEmail == request.auth.token.email;
    }
    function vetClinicalChangeValid(d, changeId) {
      let keys = ['recordType','recordId','before','after','reason','createdAt','actorUid','actorEmail'];
      return d.keys().hasAll(keys) && d.keys().hasOnly(keys)
        && d.recordType in ['patient','visit'] && vetText(d.recordId,1,128)
        && d.recordId.matches('[A-Za-z0-9_-]+')
        && (d.before == null || d.before is map) && d.after is map
        && d.after.lastChangeId == changeId && d.after.updatedAt == request.time
        && d.after.updatedBy == request.auth.uid && d.after.updatedEmail == request.auth.token.email
        && d.createdAt == request.time && d.actorUid == request.auth.uid
        && d.actorEmail == request.auth.token.email
        && vetText(d.reason, d.before == null ? 0 : 5, 300);
    }
    function vetClinicalPair(path, d) {
      return getAfter(path).data == d.after
        && (exists(path) ? get(path).data == d.before : d.before == null);
    }
    match /vetPacientes/{patientId} {
      allow read: if isVetAdmin();
      allow create: if isVetAdmin() && vetPatientValid(request.resource.data)
        && vetClinicalNew(request.resource.data) && vetClinicalLogged(patientId,'patient',patientId,null);
      allow update: if isVetAdmin() && vetPatientValid(request.resource.data)
        && vetClinicalUpdate(request.resource.data,resource.data)
        && vetClinicalLogged(patientId,'patient',patientId,resource.data);
      allow delete: if false;
      match /atenciones/{visitId} {
        allow read: if isVetAdmin();
        allow create: if isVetAdmin() && exists(/databases/$(database)/documents/vetPacientes/$(patientId))
          && vetVisitValid(request.resource.data) && vetClinicalNew(request.resource.data)
          && vetClinicalLogged(patientId,'visit',visitId,null);
        allow update: if isVetAdmin() && vetVisitValid(request.resource.data)
          && vetClinicalUpdate(request.resource.data,resource.data)
          && vetClinicalLogged(patientId,'visit',visitId,resource.data);
        allow delete: if false;
      }
      match /cambios/{changeId} {
        allow read: if isVetAdmin();
        allow create: if isVetAdmin() && vetClinicalChangeValid(request.resource.data,changeId)
          && ((request.resource.data.recordType == 'patient' && request.resource.data.recordId == patientId
               && vetClinicalPair(/databases/$(database)/documents/vetPacientes/$(patientId),request.resource.data))
           || (request.resource.data.recordType == 'visit'
               && vetClinicalPair(/databases/$(database)/documents/vetPacientes/$(patientId)/atenciones/$(request.resource.data.recordId),request.resource.data)));
        allow update, delete: if false;
      }
    }

    // Todo lo demás queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
